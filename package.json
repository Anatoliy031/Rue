{
  "name": "doroga-v-guzeripl",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Дорога в Гузерипль — интерактивный путеводитель Краснодар → Гузерипль",
  "scripts": {
    "dev": "vite",
    "validate": "node scripts/validate-data.mjs",
    "geocode": "node scripts/geocode.mjs",
    "report": "node scripts/data-report.mjs",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "prebuild": "npm run validate && npm run report && npm run sitemap",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "framer-motion": "^11.3.19",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^0.427.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.12",
    "@types/leaflet.markercluster": "^1.5.4",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  }
}
